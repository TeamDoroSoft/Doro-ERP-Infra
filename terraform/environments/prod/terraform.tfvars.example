# Deliberately invalid placeholder. Replace it with the approved current /32
# before planning so an example CIDR can never replace the operational value.
eks_public_access_cidrs = ["REPLACE_WITH_APPROVED_PUBLIC_IP/32"]

# Change only when a different approved IAM principal manages Kubernetes.
eks_admin_principal_arn = "arn:aws:iam::727646470302:user/a-student-06"

# Optional. Leave null until an operator is ready to confirm the SNS email subscription.
operations_alarm_email = null

# Prod container logs are retained for 14 days by default.
cloudwatch_log_retention_days = 14

# Keep false for the foundation apply. Set true only after the Gateway API ALB
# doro-erp-prod-alpha-gateway exists and its Edge target is healthy.
enable_gateway_backend = false
